# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Project owner/deployer key. Hardhat also accepts the legacy PRIVATE_KEY name.
MINT_OWNER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC endpoints
POLYGON_RPC_URL=https://polygon-rpc.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
BASE_RPC_URL=https://mainnet.base.org

# DeVert main-radio scheduler uses the existing DJuke fulfiller worker wallet.
# It remains distinct from the owner/admin wallet and needs Base ETH for gas.
DEVERT_SCHEDULER_ADDRESS=0x4894698f2B5cAF13Fad4Aa8fbaFE3618b960909F

# Polygonscan API key for contract verification
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY_HERE
