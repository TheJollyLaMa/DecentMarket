{
  "name": "decent-market-contracts",
  "version": "0.2.0",
  "description": "Smart contracts for DecentMarket — ERC-1155 editionable NFT for products and users",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy_DecentNFT_v02.js --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy_DecentNFT_v02.js --network amoy",
    "deploy:polygon": "hardhat run scripts/deploy_DecentNFT_v02.js --network polygon",
    "export:abi": "node scripts/export_abi.js",
    "export:dbusk-abis": "hardhat compile && node scripts/export_dbusk_abis.js",
    "rehearse:dbusk:fork": "BASE_FORK_RPC=${BASE_FORK_RPC:-https://base-rpc.publicnode.com} hardhat run scripts/rehearse_dbusk_fork.js",
    "deploy:dbusk:base": "hardhat run scripts/deploy_dbusk_base.js --network base",
    "configure:djuke:base": "hardhat run scripts/configure_djuke_songs.js --network base"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.6.1",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  }
}
